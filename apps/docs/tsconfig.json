{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // AI modified: paths resolve from this config without TypeScript 7's removed baseUrl option.
    "paths": {
      "@/*": ["./*"]
    },
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client"
    ],
    // AI modified: shared configuration modules keep explicit TypeScript extensions for Node and VitePress loaders.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    // AI modified: type-check configs, API route metadata, and browser specs instead of leaving coverage gaps.
    ".vitepress/**/*.ts",
    ".vitepress/**/*.vue",
    "*.config.ts",
    "components/**/*.ts",
    "components/**/*.vue",
    "e2e/**/*.ts",
    // AI modified: the shared Playwright server and browser matrix must remain inside a TypeScript gate.
    "../../playwright.config.ts",
    "lib/**/*.ts",
    "examples/**/*.ts",
    "examples/**/*.vue",
    "zh/api/**/*.ts",
    // AI modified: VitePress Markdown SFC blocks must participate in vue-tsc validation.
    "**/*.md",
    "*.test.ts"
  ],
  "exclude": [
    ".vitepress/dist",
    // AI modified: TypeDoc output is generated Markdown, not authored VitePress SFC source.
    "api/**/*.md"
  ],
  "vueCompilerOptions": {
    "vitePressExtensions": [".md"]
  }
}
