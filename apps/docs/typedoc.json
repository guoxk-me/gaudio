{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "../../packages/gaudio/src/index.ts",
    "../../packages/gaudio/src/adapters/hls/index.ts",
    "../../packages/gaudio/src/adapters/dash/index.ts"
  ],
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "tsconfig": "../../packages/gaudio/tsconfig.json",
  "out": "api",
  "entryFileName": "index",
  "readme": "api-overview.md",
  "mergeReadme": true,
  "cleanOutputDir": true,
  "excludeInternal": true,
  "requiredToBeDocumented": [
    "Module",
    "Namespace",
    "Enum",
    "EnumMember",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "Constructor",
    "Property",
    "Method",
    "CallSignature",
    "IndexSignature",
    "ConstructorSignature",
    "Parameter",
    "TypeParameter",
    "Accessor",
    "GetSignature",
    "SetSignature",
    "TypeAlias",
    "Reference"
  ],
  "treatValidationWarningsAsErrors": true,
  "validation": {
    "notDocumented": true
  },
  "intentionallyNotExported": [
    "DashSettingChanges",
    "EventHandler"
  ]
}
