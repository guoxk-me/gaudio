{
  "name": "@gaudio/docs",
  "type": "module",
  "private": true,
  "scripts": {
    "api": "typedoc",
    "build": "pnpm run api && vitepress build .",
    "audio:samples": "node scripts/generate-demo-audio.mjs",
    "covers": "node scripts/generate-cover-thumbs.mjs",
    "dev": "pnpm run api && vitepress dev .",
    "e2e": "playwright test --config ../../playwright.config.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lucide/vue": "^1.22.0",
    "@tailwindcss/vite": "^4.3.2",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dashjs": "^5.2.0",
    "gaudio": "workspace:*",
    "hls.js": "^1.6.16",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "sharp": "^0.35.4",
    "tw-animate-css": "^1.4.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.5"
  }
}
