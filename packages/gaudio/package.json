{
  "name": "gaudio",
  "type": "module",
  "version": "0.4.0",
  "description": "A browser-first TypeScript audio streaming library.",
  "author": "guoxk-me",
  "license": "MIT",
  "homepage": "https://guoxk-me.github.io/gaudio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoxk-me/gaudio.git"
  },
  "bugs": {
    "url": "https://github.com/guoxk-me/gaudio/issues"
  },
  "keywords": [
    "audio",
    "streaming",
    "hls",
    "dash",
    "browser",
    "media",
    "player",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./hls": {
      "import": {
        "types": "./dist/hls.d.ts",
        "default": "./dist/hls.js"
      },
      "require": {
        "types": "./dist/hls.d.cts",
        "default": "./dist/hls.cjs"
      }
    },
    "./dash": {
      "import": {
        "types": "./dist/dash.d.ts",
        "default": "./dist/dash.js"
      },
      "require": {
        "types": "./dist/dash.d.cts",
        "default": "./dist/dash.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "hls": [
        "./dist/hls.d.ts"
      ],
      "dash": [
        "./dist/dash.d.ts"
      ]
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown && node scripts/include-declaration-source-content.mjs && node scripts/verify-declaration-source-maps.mjs",
    "coverage": "vitest run --coverage",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "pack:dry-run": "corepack pnpm@10.28.0 pack --dry-run",
    "prepublishOnly": "node scripts/validate-release-changelog.mjs --package-publish && tsc --noEmit && vitest run && tsdown && node scripts/include-declaration-source-content.mjs && node scripts/verify-declaration-source-maps.mjs && corepack pnpm@10.28.0 pack --dry-run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:declaration-maps": "node scripts/verify-declaration-source-maps.mjs"
  },
  "peerDependencies": {
    "dashjs": "^5.2.0",
    "hls.js": ">=1.6.16 <1.7.0"
  },
  "peerDependenciesMeta": {
    "dashjs": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^24.13.3",
    "dashjs": "^5.2.0",
    "hls.js": "~1.6.16",
    "publint": "^0.3.22",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
